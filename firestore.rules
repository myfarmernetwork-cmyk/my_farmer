rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return callerExists()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Klijent ne smije mijenjati ulogu nakon kreiranja dokumenta.
    function roleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    function validInitialRole() {
      return request.resource.data.role is string
        && request.resource.data.role.size() > 0
        && request.resource.data.role.size() <= 64;
    }

    function followerCountDeltaAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followerCount'])
        && request.resource.data.followerCount is int
        && request.resource.data.followerCount >= 0
        && (
          !('followerCount' in resource.data)
            && request.resource.data.followerCount <= 1
          || request.resource.data.followerCount
            == resource.data.get('followerCount', 0) + 1
          || request.resource.data.followerCount
            == resource.data.get('followerCount', 0) - 1
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      // Beta: vlasnik smije kreirati/ažurirati vlastiti profil (uključujući merge bez role).
      allow create, update: if isSignedIn() && (
        isAdmin()
        || isOwner(userId)
        || followerCountDeltaAllowed()
      );

      allow delete: if isAdmin();

      match /weather_alert_state/{alertKey} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /payment_methods/{methodId} {
        // Kupac mora vidjeti PayPal/IBAN prodavača pri peer-to-peer narudžbi.
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.buyerId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && (resource.data.buyerId == request.auth.uid || isAdmin());
      }
    }

    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /animals/{animalId} {
      allow read, write: if isSignedIn();
    }

    match /veterinary_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /vet_field_reports/{reportId} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.vetId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.vetId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.farmerName is string
        && request.resource.data.farmerName.size() > 0;

      allow update, delete: if isSignedIn()
        && (isAdmin() || resource.data.vetId == request.auth.uid);
    }

    match /chat_rooms/{roomId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /followers/{followerId} {
      allow read: if isSignedIn() && (
        resource == null || resource.data.buyerId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.buyerId == request.auth.uid;
      allow update: if false;
    }

    match /scan_history/{scanId} {
      allow read, write: if isSignedIn();
    }

    match /registered_devices/{deviceId} {
      allow read, write: if isSignedIn();
    }

    match /land_parcels/{parcelId} {
      allow read, write: if isSignedIn();
    }

    match /community_posts/{postId} {
      allow read, write: if isSignedIn();
    }

    function isForumCommentCountIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['commentCount'])
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount
          == resource.data.get('commentCount', 0) + 1;
    }

    match /forum_topics/{topicId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.category is string
        && request.resource.data.authorName is string;

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.authorId == request.auth.uid
        || isForumCommentCountIncrement()
      );

      allow delete: if isSignedIn() && (
        isAdmin()
        || resource.data.authorId == request.auth.uid
      );
    }

    match /forum_comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.topicId is string
        && request.resource.data.topicId.size() > 0
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.authorName is string;

      allow update, delete: if isSignedIn() && (
        isAdmin()
        || resource.data.authorId == request.auth.uid
      );
    }

    function isStockOnlyCatalogUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock', 'updatedAt']);
    }

    match /company_catalog/{sellerId}/items/{itemId} {
      // Farmer upravlja katalogom; kupac smije samo sinkronizirati zalihe nakon narudžbe.
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == sellerId;
      allow update: if isSignedIn() && (
        request.auth.uid == sellerId
        || isStockOnlyCatalogUpdate()
      );
    }
  }
}
